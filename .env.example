# Copy to .env (never commit .env). Values here are for local dev only.
ENV=development
LOG_LEVEL=INFO

# App connects to Postgres/Redis. In compose, hosts are "postgres" / "redis".
DATABASE_URL=postgresql+asyncpg://pfc:change-me-db@localhost:5432/pfc
REDIS_URL=redis://:change-me-redis@localhost:6379/0

# Used by compose to create the DB / set the Redis password.
POSTGRES_USER=pfc
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=pfc
REDIS_PASSWORD=change-me-redis

# Signing/encryption secret. Production refuses to start with the default or
# anything shorter than 32 chars. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-change-me

# Origins allowed to send state-changing requests (same origin via Caddy in prod).
ALLOWED_ORIGINS=["http://localhost:3000"]

# Caddy: public hostname (localhost = self-signed for local testing)
DOMAIN=localhost
